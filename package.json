{
  "name": "m-typora",
  "version": "0.1.0",
  "description": "A minimal, seamless WYSIWYG Markdown editor inspired by Typora",
  "main": "./out/main/index.js",
  "private": true,
  "author": "lijiajun",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder --publish never",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke": "electron-vite build && M_TYPORA_SMOKE=out/smoke.png electron .",
    "test:e2e": "electron-vite build && node scripts/e2e/run.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.38.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/raleway": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@milkdown/crepe": "^7.22.3",
    "@milkdown/kit": "^7.22.3",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.17",
    "gemoji": "^8.1.0",
    "katex": "^0.19.0",
    "mdast-util-gfm-table": "^2.0.0",
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.8.3",
    "vite": "^8.3.5"
  }
}
